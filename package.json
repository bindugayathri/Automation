{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E tests for saucedemo.com",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "demo": "cross-env SLOW_MO=800 playwright test --headed --project=chromium --workers=1",
    "demo:checkout": "playwright test --config=playwright.demo.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3"
  }
}
