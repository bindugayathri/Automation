{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests", "demo", "pages", "fixtures", "utils", "test-data", "playwright.config.ts", "playwright.demo.config.ts"]
}
